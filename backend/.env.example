# Copy this file to .env and adjust as needed.

# --- Database -------------------------------------------------------------
# Defaults to local SQLite (zero setup). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/invoiceiq
DATABASE_URL=

# --- AI (OpenAI) ----------------------------------------------------------
# Required only for live document extraction / explanation.
# The app and Demo Mode work fully without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_MB=10

# --- Frontend CORS --------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
